PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Required for the API to store/read widgets at all
DATABASE_URL=

# Required to use the dashboard's admin panel
ADMIN_PASSWORD=

# Required: every widget is hardcoded to claude-haiku-4-5-20251001 (see
# README "Model"), so this is the only LLM key currently used.
ANTHROPIC_API_KEY=

# Unused while the model above is hardcoded - only relevant if that forced
# model is removed from server/src/app.js.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Slack or Discord incoming webhook URL for 75/90/95% usage alerts
# and for provider-failure alerts (see below)
ALERT_WEBHOOK_URL=

# Optional: cap on /api/chat requests per widget+IP per minute (default 20)
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional: consecutive /api/chat failures (per provider) before ALERT_WEBHOOK_URL
# fires a failure alert (default 3)
CHAT_FAILURE_ALERT_THRESHOLD=3