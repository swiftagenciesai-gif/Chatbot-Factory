PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Required for the API to store/read widgets at all
DATABASE_URL=

# Required to use the dashboard's admin panel
ADMIN_PASSWORD=

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude provider
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Slack or Discord incoming webhook URL for 75/90/95% usage alerts
ALERT_WEBHOOK_URL=

# Optional: cap on /api/chat requests per widget+IP per minute (default 20)
CHAT_RATE_LIMIT_PER_MINUTE=20