PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude provider
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# Required only if your API key is "identity-linked" (tied to your Console
# login rather than a standalone org key) -- Anthropic will return a 400
# ("anthropic-workspace-id is required...") without it. Find it in the
# Anthropic Console under Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=